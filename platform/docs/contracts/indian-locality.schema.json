{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "country": {
      "type": "string",
      "const": "IN"
    },
    "state": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "district": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "city": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "citySlug": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "locality": {
      "type": "string",
      "minLength": 2,
      "maxLength": 180
    },
    "street": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300
    },
    "building": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 180
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "floor": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "landmark": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "postalCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{5}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "serviceArea": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "country",
    "state",
    "city",
    "citySlug",
    "locality",
    "street"
  ],
  "additionalProperties": false
}
