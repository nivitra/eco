{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timezone": {
      "type": "string",
      "const": "Asia/Kolkata"
    },
    "weekly": {
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "unknown",
              "appointment_only"
            ]
          },
          "periods": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "opens": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "closes": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "endsNextDay": {
                  "default": false,
                  "type": "boolean"
                },
                "appointmentOnly": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "opens",
                "closes",
                "endsNextDay",
                "appointmentOnly"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "day",
          "state",
          "periods"
        ],
        "additionalProperties": false
      }
    },
    "exceptions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "unknown",
              "appointment_only"
            ]
          },
          "periods": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "opens": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "closes": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "endsNextDay": {
                  "default": false,
                  "type": "boolean"
                },
                "appointmentOnly": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "opens",
                "closes",
                "endsNextDay",
                "appointmentOnly"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 180
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "date",
          "state",
          "periods"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "timezone",
    "weekly",
    "exceptions"
  ],
  "additionalProperties": false
}
