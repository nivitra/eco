{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "graphID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "buildingID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sample": {
      "type": "boolean"
    },
    "floors": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "order": {
            "type": "number"
          },
          "planAssetID": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "frame": {
            "type": "object",
            "properties": {
              "units": {
                "type": "string",
                "enum": [
                  "percent",
                  "metres",
                  "pixels"
                ]
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "origin": {
                "type": "string",
                "const": "top-left"
              },
              "xAxis": {
                "type": "string",
                "const": "right"
              },
              "yAxis": {
                "type": "string",
                "const": "down"
              },
              "calibrationRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "surveyed": {
                "type": "boolean"
              }
            },
            "required": [
              "units",
              "width",
              "height",
              "origin",
              "xAxis",
              "yAxis",
              "calibrationRevision",
              "surveyed"
            ],
            "additionalProperties": false
          },
          "boundary": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "order",
          "planAssetID",
          "frame",
          "boundary"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "minItems": 2,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "floorID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "approach",
              "entrance",
              "waypoint",
              "stairs",
              "lift",
              "ramp",
              "destination"
            ]
          },
          "localPosition": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "outdoorPoint": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "accuracyMetres": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "survey",
                      "owner_observation"
                    ]
                  },
                  "verifiedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "validUntil": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                },
                "required": [
                  "latitude",
                  "longitude",
                  "accuracyMetres",
                  "source",
                  "verifiedAt",
                  "validUntil"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "labelByLocale": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "permittedPhotoIDs": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "evidenceID": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "accessPolicy": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "unknown",
                  "blocked"
                ]
              },
              "evidenceID": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "schedule": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "timeZone": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "weekly": {
                        "maxItems": 7,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "day": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 6
                            },
                            "intervals": {
                              "maxItems": 8,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "start": {
                                    "type": "string",
                                    "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                                  },
                                  "end": {
                                    "type": "string",
                                    "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                                  }
                                },
                                "required": [
                                  "start",
                                  "end"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "day",
                            "intervals"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "exceptions": {
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "date": {
                              "type": "string",
                              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                            },
                            "intervals": {
                              "maxItems": 8,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "start": {
                                    "type": "string",
                                    "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                                  },
                                  "end": {
                                    "type": "string",
                                    "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                                  }
                                },
                                "required": [
                                  "start",
                                  "end"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "date",
                            "intervals"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "timeZone",
                      "weekly",
                      "exceptions"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "state",
              "evidenceID",
              "schedule"
            ],
            "additionalProperties": false
          },
          "connectorID": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "floorID",
          "type",
          "localPosition",
          "outdoorPoint",
          "labelByLocale",
          "permittedPhotoIDs",
          "evidenceID",
          "accessPolicy",
          "connectorID"
        ],
        "additionalProperties": false
      }
    },
    "directedEdges": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "fromNodeID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "toNodeID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "traversalType": {
            "type": "string",
            "enum": [
              "pavement",
              "crossing",
              "entrance",
              "corridor",
              "stairs",
              "lift",
              "ramp"
            ]
          },
          "geometry": {
            "anyOf": [
              {
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "floorID": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "floorID"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "lengthMetres": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "baseDurationSeconds": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 7200
              },
              {
                "type": "null"
              }
            ]
          },
          "costSource": {
            "type": "string",
            "enum": [
              "measured",
              "estimated",
              "unknown"
            ]
          },
          "steps": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "restrictionRefs": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
            }
          },
          "turnInstructionRefs": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
            }
          },
          "permittedModes": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "walking",
                "driving"
              ]
            }
          },
          "openingSchedule": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "timeZone": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "weekly": {
                    "maxItems": 7,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "day": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 6
                        },
                        "intervals": {
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": "string",
                                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                              },
                              "end": {
                                "type": "string",
                                "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                              }
                            },
                            "required": [
                              "start",
                              "end"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "day",
                        "intervals"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "exceptions": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "date": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        "intervals": {
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": "string",
                                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                              },
                              "end": {
                                "type": "string",
                                "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                              }
                            },
                            "required": [
                              "start",
                              "end"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "date",
                        "intervals"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "timeZone",
                  "weekly",
                  "exceptions"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "instructionByLocale": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "directionalPhotoIDs": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "verificationRef": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "accessibilityEvidence": {
            "type": "object",
            "properties": {
              "stepFree": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "unknown",
                  "no"
                ]
              },
              "evidenceID": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "clearWidthMm": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "slope": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "surface": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "stepFree",
              "evidenceID",
              "clearWidthMm",
              "slope",
              "surface"
            ],
            "additionalProperties": false
          },
          "liftID": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "accessState": {
            "type": "string",
            "enum": [
              "open",
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "id",
          "fromNodeID",
          "toNodeID",
          "traversalType",
          "geometry",
          "lengthMetres",
          "baseDurationSeconds",
          "costSource",
          "steps",
          "restrictionRefs",
          "turnInstructionRefs",
          "permittedModes",
          "openingSchedule",
          "instructionByLocale",
          "directionalPhotoIDs",
          "verificationRef",
          "accessibilityEvidence",
          "liftID",
          "accessState"
        ],
        "additionalProperties": false
      }
    },
    "entrances": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "nodeID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "approachNodeID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "permittedModes": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "walking",
                "driving"
              ]
            }
          },
          "labelByLocale": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "required": [
          "id",
          "nodeID",
          "approachNodeID",
          "permittedModes",
          "labelByLocale"
        ],
        "additionalProperties": false
      }
    },
    "placeDestinationBindings": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "placeID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "destinationNodeID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "entranceIDs": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
            }
          }
        },
        "required": [
          "placeID",
          "destinationNodeID",
          "entranceIDs"
        ],
        "additionalProperties": false
      }
    },
    "turnInstructions": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "incomingEdgeID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "outgoingEdgeID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "instructionByLocale": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "photoIDs": {
            "maxItems": 5,
            "type": "array",
            "items": {
